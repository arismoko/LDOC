{
  "name": "ldoc",
  "version": "0.1.0",
  "description": "Legal Document DSL - Compile markdown-like syntax to DOCX",
  "module": "src/index.ts",
  "type": "module",
  "bin": {
    "ldoc": "./src/cli/index.ts"
  },
  "scripts": {
    "build": "bun build src/index.ts --outdir dist --target node",
    "test": "bun test",
    "smoke": "bun run src/cli/dev-smoke.ts",
    "pack": "bunx repomix --include 'src/**,*.md'",
    "ldoc": "bun run src/cli/index.ts"
  },
  "dependencies": {
    "adm-zip": "^0.5.16",
    "diff": "^8.0.3",
    "docx": "^9.4.1",
    "fast-xml-parser": "^5.3.4",
    "image-size": "^2.0.2",
    "jszip": "^3.10.1",
    "vscode-languageserver": "^9.0.1",
    "vscode-languageserver-protocol": "^3.17.5",
    "vscode-languageserver-textdocument": "^1.0.12",
    "vscode-uri": "^3.1.0"
  },
  "devDependencies": {
    "@types/bun": "latest",
    "@types/diff": "^8.0.0",
    "@types/image-size": "^0.8.0",
    "@types/node": "^22.13.9"
  },
  "peerDependencies": {
    "typescript": "^5"
  }
}
