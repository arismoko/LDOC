{
  "output": {
    "style": "xml",
    "filePath": "repomix-output.xml",
    "removeComments": false,
    "removeEmptyLines": false,
    "topFilesLength": 5
  },
  "include": [
    "src/**/*",
    "package.json",
    "README.md",
    "AGENTS.md"
  ],
  "ignore": {
    "useGitignore": true,
    "useDotIgnore": true,
    "useDefaultPatterns": true,
    "customPatterns": [
      "**/.scratch/**",
      "**/*.docx",
      "**/*.pdf",
      "**/*.png",
      "**/*.zip",
      "**/*.lockb"
    ]
  },
  "security": {
    "enableSecurityCheck": true
  }
}
